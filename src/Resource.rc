#include <windows.h>
#include "resource.h"

// Application icon (PNG embedded as raw data, converted to HICON at runtime)
IDI_APPICON RCDATA "app_icon.png"

// Resize Dialog
IDD_RESIZE_DIALOG DIALOGEX 0, 0, 230, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resize Image"
FONT 9, "Segoe UI"
BEGIN
LTEXT           "Width:", IDC_STATIC_RESIZE_WIDTH, 7, 14, 32, 12
EDITTEXT        IDC_EDIT_WIDTH, 45, 12, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
LTEXT           "Height:", IDC_STATIC_RESIZE_HEIGHT, 7, 39, 32, 12
EDITTEXT        IDC_EDIT_HEIGHT, 45, 37, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
CONTROL         "Maintain aspect ratio", IDC_CHECK_ASPECT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 45, 62, 110, 10
DEFPUSHBUTTON   "OK", IDOK, 120, 12, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 120, 37, 50, 14
END
// Custom Zoom Dialog

IDD_ZOOM_DIALOG DIALOGEX 0, 0, 150, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Custom Zoom"
FONT 9, "Segoe UI"
BEGIN
LTEXT           "Zoom Percentage (%):", IDC_STATIC_ZOOM_LABEL, 10, 12, 75, 10
EDITTEXT        IDC_EDIT_ZOOM, 90, 10, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
DEFPUSHBUTTON   "OK", IDOK, 35, 35, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 90, 35, 50, 14
END


// Keybindings
IDD_KEYBINDINGS_DIALOG DIALOGEX 0, 0, 250, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keybindings"
FONT 9, "Segoe UI"
BEGIN
LTEXT           "Action:", IDC_STATIC_KB_ACTION, 10, 10, 40, 10
COMBOBOX        IDC_COMBO_ACTION, 50, 8, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Shortcut:", IDC_STATIC_KB_SHORTCUT, 10, 30, 40, 10
CONTROL         "", IDC_HOTKEY_CTRL, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 50, 28, 190, 14
DEFPUSHBUTTON   "Apply", IDOK, 60, 75, 50, 14
PUSHBUTTON      "Restore Defaults", IDC_BTN_RESTORE_DEFAULTS, 115, 75, 70, 14
PUSHBUTTON      "Close", IDCANCEL, 190, 75, 50, 14
END

// Preferences Dialog
IDD_PREFERENCES_DIALOG DIALOGEX 0, 0, 250, 390
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences"
FONT 9, "Segoe UI"
BEGIN
GROUPBOX                "Default Background Color", IDC_STATIC_BG_GROUP, 10, 10, 230, 70
CONTROL                 "Grey (Default)", IDC_RADIO_BG_GREY, "Button", BS_AUTORADIOBUTTON, 20, 25, 100, 10
CONTROL                 "Black", IDC_RADIO_BG_BLACK, "Button", BS_AUTORADIOBUTTON, 20, 40, 100, 10
CONTROL                 "White", IDC_RADIO_BG_WHITE, "Button", BS_AUTORADIOBUTTON, 130, 25, 100, 10
CONTROL                 "Transparent", IDC_RADIO_BG_TRANSPARENT, "Button", BS_AUTORADIOBUTTON, 130, 40, 100, 10

GROUPBOX                "Application Settings", IDC_STATIC_APP_GROUP, 10, 85, 230, 170
CONTROL                 "Always on Top", IDC_CHECK_ALWAYS_ON_TOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 100, 210, 10
CONTROL                 "Start in full screen", IDC_CHECK_START_FULLSCREEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 115, 210, 10
CONTROL                 "Enforce single instance", IDC_CHECK_SINGLE_INSTANCE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 130, 210, 10
CONTROL                 "Auto Refresh (Reload if file changes)", IDC_CHECK_AUTO_REFRESH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 145, 210, 10
CONTROL                 "Smooth Scaling (Interpolation)", IDC_CHECK_SMOOTH_SCALING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 160, 210, 10
CONTROL                 "Enable Image Fade Animation", IDC_CHECK_FADE_ANIMATION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 175, 210, 10
CONTROL                 "Show Image Info Overlay (OSD)", IDC_CHECK_SHOW_OSD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 190, 210, 10
CONTROL                 "Ask before deleting", IDC_CHECK_ASK_DELETE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 205, 210, 10
CONTROL                 "Preserve zoom on resize/fullscreen", IDC_CHECK_PRESERVE_ZOOM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 220, 210, 10
CONTROL                 "Auto-move window to matching display", IDC_CHECK_AUTO_MONITOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 235, 210, 10

GROUPBOX                "Default Zoom Mode", IDC_STATIC_ZOOM_GROUP, 10, 262, 230, 45
CONTROL                 "Fit to Window", IDC_RADIO_ZOOM_FIT, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 20, 277, 100, 10
CONTROL                 "Actual Size (100%)", IDC_RADIO_ZOOM_ACTUAL, "Button", BS_AUTORADIOBUTTON, 130, 277, 100, 10

GROUPBOX                "Language", IDC_STATIC_LANG_GROUP, 10, 314, 230, 45
CONTROL                 "Chinese (Simplified)", IDC_RADIO_LANG_ZH, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 20, 329, 100, 10
CONTROL                 "English", IDC_RADIO_LANG_EN, "Button", BS_AUTORADIOBUTTON, 130, 329, 100, 10

DEFPUSHBUTTON           "OK", IDOK, 138, 368, 50, 14
PUSHBUTTON              "Cancel", IDCANCEL, 190, 368, 50, 14
END

//
//
// Version
//
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2, 0, 1, 0
PRODUCTVERSION 2, 0, 1, 0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904b0"
BEGIN
VALUE "CompanyName", "Deminimis"
VALUE "FileDescription", "Minimal Image Viewer"
VALUE "FileVersion", "1.9.1.0"
VALUE "InternalName", "MinimalImageViewer.exe"
VALUE "LegalCopyright", "Deminimis"
VALUE "OriginalFilename", "MinimalImageViewer.exe"
VALUE "ProductName", "Minimal Image Viewer"
VALUE "ProductVersion", "1.9.1.0"
END
END
BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x409, 1200
END
END